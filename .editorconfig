root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

[go.mod]
indent_style = tab
indent_size = 4
tab_width = 4

[go.work]
indent_style = tab
indent_size = 4
tab_width = 4

[Makefile]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{css,html,js,json,mjs,proto,yaml,yml}]
indent_style = space
indent_size = 2

[*.{py,ps1}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
